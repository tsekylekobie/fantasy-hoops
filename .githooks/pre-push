#!/bin/sh
# Stops a push when the import check, the tests or typecheck fail. Checks each
# commit being pushed, exported to a temp folder, not the working tree: parallel
# sessions can leave half-finished edits there. The folder is inside the checkout
# so packages still resolve up the tree (worktrees use the main checkout's).
#   git config core.hooksPath .githooks     # once per clone (worktrees share it)
#   git push --no-verify                    # skip it
set -eu
export PATH="$HOME/.local/node/bin:$PATH"

root=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d "$root/.pre-push.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

check() {
  dir="$tmp/$1"
  mkdir "$dir"
  git archive "$1" | tar -x -C "$dir"
  # Generated by Next.js and git-ignored, but typecheck needs its CSS module types.
  [ -f "$dir/next-env.d.ts" ] || cp "$root/next-env.d.ts" "$dir/" 2>/dev/null || true
  (
    cd "$dir"
    npm run --silent check:client-imports
    npm test --silent >"$tmp/test.log" 2>&1 || { cat "$tmp/test.log" >&2; exit 1; }
    npm run --silent typecheck
  )
}

# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r _ sha _ _; do
  case "$sha" in
    *[!0]*) echo "pre-push: checking ${sha%"${sha#???????}"}" >&2; check "$sha" </dev/null ;;
    *) ;; # all zeros: a branch being deleted
  esac
done
echo "pre-push: all checks passed." >&2
