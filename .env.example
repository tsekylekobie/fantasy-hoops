# Copy to .env and fill in. Never commit .env.
BALLDONTLIE_API_KEY=
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/v1
# Requests per minute allowed by your BALLDONTLIE tier (ALL-STAR: 60, trial: 5)
BALLDONTLIE_RPM=60

DATABASE_URL=postgres://localhost:5432/fantasy_hoops

# Google sign-in. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
# <APP_URL>/api/auth/google/callback (e.g. http://localhost:3000/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the app; defaults to the request's origin.
APP_URL=http://localhost:3000
# Local dev only: 1 = use the mock sign-in page instead of Google. Mock sign-in
# is also used automatically in dev when GOOGLE_CLIENT_ID is empty, and is
# always off in production builds.
AUTH_MOCK=1
