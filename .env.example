# Copy to .env and fill in. Never commit .env.
# NBA data: espn (default; keyless, paced at ESPN_RPS requests/second, default 1) or bdl (BALLDONTLIE, below).
DATA_PROVIDER=espn
# ESPN_RPS=1
BALLDONTLIE_API_KEY=
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/v1
# Requests per minute allowed by your BALLDONTLIE tier (ALL-STAR: 60, trial: 5)
BALLDONTLIE_RPM=60

# Sync worker (npm run worker); all optional.
# WORKER_LIVE_SECONDS=30           # how often to refresh while a game is live
# WORKER_CORRECTIONS_HOUR=9        # daily stat-corrections pass, league local time
# WORKER_TIME_ZONE=America/New_York

DATABASE_URL=postgres://localhost:5432/fantasy_hoops

# Injury alerts (Web Push), on web and worker; alerts are off while the keys are empty.
# Generate the pair once: npx web-push generate-vapid-keys (README, "Injury alerts").
# Keep the same pair forever: a new one silently breaks every saved subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach: mailto:you@example.com (or the app's https URL).
VAPID_SUBJECT=

# Google sign-in. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
# <APP_URL>/api/auth/google/callback (e.g. http://localhost:3000/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the app; defaults to Railway's RAILWAY_PUBLIC_DOMAIN, then the request's origin.
APP_URL=http://localhost:3000
# Local dev only: 1 = use the mock sign-in page instead of Google. Mock sign-in
# is also used automatically in dev when GOOGLE_CLIENT_ID is empty, and is
# always off in production builds.
AUTH_MOCK=1

# Yahoo Fantasy API: the league's source of truth (README, "Mirroring the league from Yahoo (API)"), on web and
# worker. Create an app at https://developer.yahoo.com/apps/create/ (Web Application, Fantasy Sports: Read) with
# the redirect URI <APP_URL>/api/yahoo/callback (https only). The sync is off until the commissioner connects at /league/yahoo.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Encrypts the stored Yahoo tokens: openssl rand -base64 32. Changing it means reconnecting.
YAHOO_TOKEN_KEY=
# YAHOO_REFRESH_MINUTES=5          # how often the worker refreshes rosters and transactions
